{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://365explained.example/schema/events.schema.json",
  "title": "365Explained Frontier Model Tracker dataset",
  "type": "object",
  "required": ["version", "updated", "events"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "updated": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "events": {
      "type": "array",
      "items": {"$ref": "#/$defs/event"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "platform": {
      "type": "object",
      "required": ["owner", "product"],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "product": {"type": "string", "minLength": 1},
        "experience": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["publisher", "title", "url"],
      "properties": {
        "publisher": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https://"}
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["id", "date", "vendor", "model", "platform", "event_type", "status", "selectable", "confidence", "sources"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
        "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "vendor": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "platform": {"$ref": "#/$defs/platform"},
        "event_type": {
          "type": "string",
          "enum": ["vendor_release", "platform_launch", "limited_preview", "public_preview", "underlying_model", "specialist_experience", "model_picker", "general_availability", "default_model", "catalog_availability", "retirement", "policy_change", "suspension", "restoration"]
        },
        "status": {"type": "string", "minLength": 1},
        "selectable": {"type": "boolean"},
        "confidence": {"type": "string", "enum": ["confirmed", "probable", "needs-verification"]},
        "notes": {"type": "string"},
        "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}
      },
      "additionalProperties": false
    }
  }
}
