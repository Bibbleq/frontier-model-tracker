{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://365explained.example/schema/events.schema.json",
  "title": "365Explained Frontier Model Tracker dataset",
  "type": "object",
  "required": ["version", "updated", "research_cutoff", "metadata", "events", "validation_backlog"],
  "properties": {
    "version": {"const": 2},
    "updated": {"$ref": "#/$defs/day"},
    "research_cutoff": {"$ref": "#/$defs/day"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "events": {
      "type": "array",
      "items": {"$ref": "#/$defs/event"}
    },
    "validation_backlog": {
      "type": "array",
      "items": {"$ref": "#/$defs/validation_item"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "day": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "partial_date": {
      "type": "string",
      "pattern": "^\\d{4}(?:-\\d{2}(?:-\\d{2})?)?$"
    },
    "metadata": {
      "type": "object",
      "required": ["project", "purpose", "interpretation_rules", "confidence_definitions", "import_provenance"],
      "properties": {
        "project": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "interpretation_rules": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "confidence_definitions": {
          "type": "object",
          "required": ["confirmed", "supported"],
          "properties": {
            "confirmed": {"type": "string", "minLength": 1},
            "supported": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "import_provenance": {
          "type": "object",
          "required": ["seed_archive_sha256", "editorial_backlog_sha256", "canonical_seed_events", "canonical_seed_validation_items", "published_events", "validation_items"],
          "properties": {
            "seed_archive_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
            "editorial_backlog_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
            "canonical_seed_events": {"type": "integer", "minimum": 1},
            "canonical_seed_validation_items": {"type": "integer", "minimum": 0},
            "published_events": {"type": "integer", "minimum": 1},
            "validation_items": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "platform": {
      "type": "object",
      "required": ["owner", "family", "product"],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "family": {"type": "string", "minLength": 1},
        "product": {"type": "string", "minLength": 1},
        "experience": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "event_detail": {
      "type": "object",
      "required": ["type", "availability", "selectable"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "vendor_release",
            "platform_launch",
            "platform_milestone",
            "strategic_milestone",
            "limited_preview",
            "public_preview",
            "ga",
            "rollout",
            "underlying_model",
            "confirmed_in_use",
            "model_picker",
            "specialist_experience",
            "default_model",
            "catalogue_availability",
            "retirement",
            "admin_policy",
            "suspension",
            "restoration"
          ]
        },
        "availability": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "selectable": {"type": ["boolean", "null"]}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["publisher", "title", "url", "primary", "retrieved_at"],
      "properties": {
        "publisher": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https://"},
        "primary": {"type": "boolean"},
        "retrieved_at": {"$ref": "#/$defs/day"},
        "published_at": {"$ref": "#/$defs/partial_date"},
        "source_type": {
          "type": "string",
          "enum": ["announcement", "changelog", "documentation", "release_notes", "news", "other"]
        },
        "archived_url": {"type": "string", "pattern": "^https://"},
        "note": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "event_relation": {
      "type": "object",
      "required": ["id", "relation"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
        "relation": {
          "type": "string",
          "enum": ["vendor_release", "same_announcement", "replacement", "retirement", "other"]
        }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["id", "date", "date_precision", "vendor", "model", "platform", "event", "confidence", "evidence_note", "sources"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
        "date": {"$ref": "#/$defs/partial_date"},
        "date_precision": {"type": "string", "enum": ["day", "month", "year"]},
        "vendor": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "models": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "platform": {"$ref": "#/$defs/platform"},
        "event": {"$ref": "#/$defs/event_detail"},
        "confidence": {"type": "string", "enum": ["confirmed", "supported"]},
        "evidence_note": {"type": "string", "minLength": 1},
        "caveat": {"type": "string", "minLength": 1},
        "notes": {"type": "string", "minLength": 1},
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "related_events": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/event_relation"}
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/source"}
        }
      },
      "additionalProperties": false
    },
    "validation_item": {
      "type": "object",
      "required": ["id", "working_claim", "reason", "target"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
        "working_claim": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "sources": {
          "type": "array",
          "items": {"$ref": "#/$defs/source"}
        }
      },
      "additionalProperties": false
    }
  }
}
