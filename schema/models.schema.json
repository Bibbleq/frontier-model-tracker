{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bibbleq.github.io/frontier-model-tracker/schema/models.schema.json",
  "title": "365Explained Frontier Model Tracker model registry",
  "type": "object",
  "required": ["version", "models", "families"],
  "properties": {
    "version": {"const": 1},
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/model"}
    },
    "families": {
      "type": "array",
      "items": {"$ref": "#/$defs/family"}
    },
    "series": {
      "type": "array",
      "items": {"$ref": "#/$defs/series"}
    },
    "generations": {
      "type": "array",
      "items": {"$ref": "#/$defs/generation"}
    },
    "model_lines": {
      "type": "array",
      "items": {"$ref": "#/$defs/model_line"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "model": {
      "type": "object",
      "required": ["id", "display_name", "vendor"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "display_name": {"type": "string", "minLength": 1},
        "vendor": {"type": "string", "minLength": 1},
        "family": {"$ref": "#/$defs/identifier"},
        "generation": {"$ref": "#/$defs/identifier"},
        "model_line": {"$ref": "#/$defs/identifier"},
        "modality": {
          "type": "string",
          "enum": ["text", "image", "audio", "voice", "video"]
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "supersedes": {"$ref": "#/$defs/identifier"},
        "superseded_by": {"$ref": "#/$defs/identifier"},
        "note": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "family": {
      "type": "object",
      "required": ["id", "display_name", "vendor"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "display_name": {"type": "string", "minLength": 1},
        "vendor": {"type": "string", "minLength": 1},
        "note": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "series": {
      "type": "object",
      "required": ["id", "display_name", "vendor"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "display_name": {"type": "string", "minLength": 1},
        "vendor": {"type": "string", "minLength": 1},
        "note": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "generation": {
      "type": "object",
      "required": ["id", "display_name", "vendor", "series"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "display_name": {"type": "string", "minLength": 1},
        "vendor": {"type": "string", "minLength": 1},
        "series": {"$ref": "#/$defs/identifier"},
        "note": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "model_line": {
      "type": "object",
      "required": ["id", "display_name", "vendor", "series"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "display_name": {"type": "string", "minLength": 1},
        "vendor": {"type": "string", "minLength": 1},
        "series": {"$ref": "#/$defs/identifier"},
        "note": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
